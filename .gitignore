.devswarm-temp/
.DS_Store

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
dist/
*.iml
.idea/

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Models (large binaries — downloaded, not committed)
models/*.bin
models/*.gguf
rust_core/models/*.bin
rust_core/models/*.gguf
!models/.gitkeep

# Generated test fixtures (regenerate via `cargo run --bin gen_fixtures`)
test/fixtures/
rust_core/test/fixtures/
rust_core/transkrip/

# Env / secrets
.env
.env.*
*.pem
*.p12
*.keystore

# OS
Thumbs.db
AppDir

# Build artifacts (ship via GitHub Releases, not repo)
dist/
transcribe.AppImage
transcribe-linux-portable.zip

# OpenWork workspace artifacts
.opencode/

# The untranslated-messages report (`flutter gen-l10n` writes it each run).
# The generated localisations under lib/l10n/generated/ are deliberately NOT
# ignored: generated Dart is committed here, same as lib/src/rust/, so a fresh
# CI checkout can analyze and test without running codegen first. That is the
# exact failure tracked_sources_test.dart exists to prevent.
l10n-untranslated.json

# Byte-cache from the Python helper scripts in scripts/
__pycache__/
