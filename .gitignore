.devswarm-temp/
.DS_Store

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
dist/
*.iml
.idea/

# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Models (large binaries — downloaded, not committed)
models/*.bin
models/*.gguf
rust_core/models/*.bin
rust_core/models/*.gguf
!models/.gitkeep

# Golden diffs. `flutter test test/golden_test.dart` writes master/test/diff
# PNGs here for every golden that does not match; they are debugging output for
# the run that produced them, never a reviewable artefact.
test/failures/

# Generated test fixtures (regenerate via `cargo run --bin gen_fixtures`).
# Written as `dir/*` rather than `dir/`, because git does not descend into an
# excluded *directory* — a `!` negation below it would never be considered.
# That is what the exception needs.
test/fixtures/*
rust_core/test/fixtures/*

# Exception: the Rust↔Dart template contract. `rust_core`'s
# `the_template_table_dart_copies_is_current` writes it and
# `test/notulen_templates_test.dart` reads it, so unlike the WAV artifacts
# beside it this one is a reviewable text file the test suite *requires* —
# ignoring it made both halves of CI fail on a fresh checkout.
!test/fixtures/notulen_templates.json
rust_core/transkrip/

# Env / secrets
.env
.env.*
*.pem
*.p12
*.keystore

# OS
Thumbs.db
AppDir

# Build artifacts (ship via GitHub Releases, not repo)
dist/
transcribe.AppImage
transcribe-linux-portable.zip

# OpenWork workspace artifacts
.opencode/

# The untranslated-messages report (`flutter gen-l10n` writes it each run).
# The generated localisations under lib/l10n/generated/ are deliberately NOT
# ignored: generated Dart is committed here, same as lib/src/rust/, so a fresh
# CI checkout can analyze and test without running codegen first. That is the
# exact failure tracked_sources_test.dart exists to prevent.
l10n-untranslated.json

# Byte-cache from the Python helper scripts in scripts/
__pycache__/
