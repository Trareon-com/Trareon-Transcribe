  "schema": [
    {
      "name": "fenced with preamble",
      "raw": "Berikut notulennya:\n```json\n{\"keputusan\": [{\"isi\": \"Pagu disetujui.\", \"segmen\": [7]}]}\n```",
      "keputusan": [["Pagu disetujui.", [7]]],
      "tindak_lanjut": []
    },
    {
      "name": "bare strings with inline citation",
      "raw": "{\"keputusan\": [\"Pagu disetujui. [#7,8]\"]}",
      "keputusan": [["Pagu disetujui.", [7, 8]]],
      "tindak_lanjut": []
    },
    {
      "name": "renamed keys and string segmen",
      "raw": "{\"kesimpulan\": [{\"keputusan\": \"Anggaran disetujui.\", \"segmen\": \"[#5]\"}], \"rencana_aksi\": [{\"kegiatan\": \"Kirim surat\", \"pic\": \"Rina\", \"batas_waktu\": \"Jumat\"}]}",
      "keputusan": [["Anggaran disetujui.", [5]]],
      "tindak_lanjut": [["Kirim surat", "Rina", "Jumat"]]
    },
    {
      "name": "trailing commas and placeholders",
      "raw": "{\"keputusan\": [{\"isi\": \"-\"}, {\"isi\": \"Pagu disetujui.\",}], \"tindak_lanjut\": [{\"tugas\": \"Kirim surat\", \"penanggung_jawab\": \"-\", \"tenggat\": \"N/A\"}],}",
      "keputusan": [["Pagu disetujui.", []]],
      "tindak_lanjut": [["Kirim surat", "", ""]]
    },
    {
      "name": "think block then the answer",
      "raw": "<think>mungkin {\"keputusan\": []} ?</think>\n{\"keputusan\": [{\"isi\": \"Pagu disetujui.\", \"segmen\": [1]}]}",
      "keputusan": [["Pagu disetujui.", [1]]],
      "tindak_lanjut": []
    },
    {
      "name": "single object instead of an array",
      "raw": "{\"tindak_lanjut\": {\"tugas\": \"Kirim surat\", \"pj\": \"Rina\"}}",
      "keputusan": [],
      "tindak_lanjut": [["Kirim surat", "Rina", ""]]
    }
  ]
